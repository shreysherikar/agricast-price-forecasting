# Environment Configuration Template
# Copy to .env for local deployment (never commit real .env files with production credentials)

# PostgreSQL Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=forecasting_db

# Database Connection URL (PostgreSQL in Docker, SQLite locally)
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/forecasting_db

# File and Artifact Paths
ARTIFACTS_DIR=outputs
DATA_PATH=data/prices.csv

# Service Ports
API_PORT=8000
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# Security & API Key
FORECAST_API_KEY=dev-forecast-key-change-in-prod
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080

# Django Gateway Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-insecure-django-secret-key-change-in-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
FASTAPI_BASE_URL=http://api:8000
FASTAPI_TIMEOUT_SECONDS=3.0
FASTAPI_CACHE_TTL_SECONDS=86400

# Monitoring & Execution
PYTHONUNBUFFERED=1
ENVIRONMENT=development
